# 站点
SITE_URL=https://kythron.com

# 数据库（本地开发用；生产由 compose 从 BLOG_DB_PASSWORD 拼出来）
DATABASE_URL=postgresql://blog:password@127.0.0.1:5432/blog
DATABASE_SSL=false

# 鉴权：npm run auth:hash -- <密码> 生成
AUTH_SECRET=
AUTH_PASSWORD_HASH=

# 上传文件目录
DATA_DIR=./data

# 服务器监控（只由服务端读取，不使用 NEXT_PUBLIC_）
NEZHA_API_URL=http://nezha-dashboard:8008
NEZHA_API_TOKEN=

# 部署（服务器 /opt/blog/.env）
# BLOG_DB_PASSWORD=
# NODE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ddn-k8s/docker.io/library/node:22-alpine
# TUNNEL_IMAGE=swr.cn-south-1.myhuaweicloud.com/promptvault/cloudflared:2026.10.4
