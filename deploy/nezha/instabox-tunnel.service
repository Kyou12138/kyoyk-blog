[Unit]
Description=Private tunnel for Nezha reports
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/ssh -F /opt/nezha-agent/ssh_config -N -L 127.0.0.1:18008:127.0.0.1:8008 blog-monitor
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
